# Database
DATABASE_URL=postgresql://user:password@localhost:5432/ascendai
DATABASE_URL_DOCKER=postgresql://user:password@host.docker.internal:5432/ascendai

# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder
CLERK_SECRET_KEY=sk_test_placeholder
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# AI (Gemini). GEMINI_API_KEYS is comma-separated; GEMINI_API_KEY is the single-key fallback.
GEMINI_API_KEYS=key1,key2
GEMINI_API_KEY=
# Routes: comma-separated provider:model in fallback order (model names live only here)
AI_ROUTE_FAST=google:your-fast-model
AI_ROUTE_WRITE=google:your-write-model
# Set to 1 (non-production only) to log prompts/outputs
AI_DEBUG=
# Per-user daily AI request cap (counts AiUsage rows, UTC day). Unset = 50. Set 0 to disable the cap.
AI_DAILY_LIMIT=

# HMAC secret for signing ATS 1-click-fix tokens. Required in production (>=32 chars); dev uses an ephemeral key.
# Generate with: openssl rand -base64 48
ATS_FIX_SIGNING_SECRET=replace_with_openssl_rand_base64_48

# Error monitoring (Sentry). Both optional: with no DSN nothing is loaded or sent.
# Personal data (request bodies, cookies, headers, users, resume/JD/answer/letter text, emails, Clerk ids) is stripped before sending.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Source-map upload at build time: only if ALL THREE are set (otherwise the build never contacts Sentry).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Secret for the pipeline cron route (GET/POST /api/cron/pipeline, header "Authorization: Bearer <secret>").
# Vercel Cron sends it automatically when CRON_SECRET is set. At least 16 chars: openssl rand -base64 32. Unset = route closed (401).
CRON_SECRET=
